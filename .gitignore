# Regenerable processed corpora / vocabularies
data/processed/train.json
data/processed/test.json
data/processed/vocab/
data/processed/meta.json

# Keep SE.1–SE.8 index files for fixed sampling
!data/processed/subsets/
!data/processed/subsets/**

# Checkpoints (large; retrain locally)
results/checkpoints/

# Local embedding downloads
*.bin
*.gz
GoogleNews*
glove.*

# Regenerable local diffs / summaries
results/metrics/summary.txt
results/metrics/paper_diff.json
results/tables/paper_diff.*
results/figures/*_paper.png
results/figures/*_paper.pdf
results/figures/*.pdf

# Caches
.cache/
**/lightning_logs/
